{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-worktree-with-main.sh\"",
            "timeout": 60,
            "statusMessage": "Syncing worktree with latest main..."
          }
        ]
      }
    ]
  }
}
